<?xml version="1.0" encoding="UTF-8"?>
<system>
  <properties>
    <id>buv-petinga</id>
    <name>BUV Petinga</name>
    <type>AUV</type>
    <model>LAUV</model>
    <appearance>
      <x-size>2.0</x-size>
      <y-size>0.6</y-size>
      <z-size>0.54</z-size>
      <top-image-2D>../vehicles-files/lauv/lauv-seacon0-top.png</top-image-2D>
      <side-image-2D>../vehicles-files/lauv/lauv-seacon0-side.png</side-image-2D>
      <back-image-2D>../vehicles-files/lauv/lauv-seacon0-back.png</back-image-2D>
      <presentation-image-2D>../vehicles-files/lauv/lauv-seacon0-presentation.png</presentation-image-2D>
      <icon-color>
        <r>0</r>
        <g>200</g>
        <b>0</b>
      </icon-color>
    </appearance>
  </properties>
  <communication-means>
    <comm-mean>
      <name>ethernet</name>
      <type>ethernet</type>
      <host-address>10.0.82.100</host-address>
      <protocols>imc</protocols>
      <protocols-args>
        <imc>
          <port>6002</port>
          <port-tcp>6002</port-tcp>
          <udp-on>true</udp-on>
          <tcp-on>false</tcp-on>
          <imc-id>20:54</imc-id>
        </imc>
      </protocols-args>
    </comm-mean>
  </communication-means>
  <feasibleManeuvers>
  <maneuver>
    <VehicleFormation kind="automatic">
      <basePoint type="pointType">
        <point>
          <id/>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
        <radiusTolerance>0.0</radiusTolerance>
      </basePoint>
      <trajectory/>
      <speed unit="m/s">1.0</speed>
      <startTime>50000</startTime>
      <participants/>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.VehicleFormation</implementation-class>
      </annotation>
    </VehicleFormation>
  </maneuver>
  <maneuver>
    <Goto kind="automatic">
      <finalPoint type="pointType">
        <point>
          <id>GotoDestination</id>
          <name>GotoDestination</name>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </finalPoint>
      <speed type="float" unit="m/s">1.0</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.Goto</implementation-class>
      </annotation>
    </Goto>
  </maneuver>
  <maneuver>
    <YoYo kind="automatic">
      <finalPoint type="pointType">
        <point>
          <id>YoYo</id>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </finalPoint>
      <amplitude>10.0</amplitude>
      <pitch>10.0</pitch>
      <speed type="float" unit="RPM">1200</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.YoYo</implementation-class>
      </annotation>
    </YoYo>
  </maneuver>
  <maneuver>
    <Loiter kind="automatic">
      <basePoint type="pointType">
        <point>
          <id>LoiterLoc</id>
          <name>LoiterLoc</name>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </basePoint>
      <duration>30</duration>
      <trajectory>
        <radius type="float">15.0</radius>
        <type>Circular</type>
        <length type="float">50.0</length>
        <bearing type="float">0.0</bearing>
        <direction>Clockwise</direction>
      </trajectory>
      <speed type="float" unit="m/s">1.3</speed>
      <annotation>
        <documentation>Loiter over a point</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.Loiter</implementation-class>
      </annotation>
    </Loiter>
  </maneuver>
  <maneuver>
    <StationKeeping kind="automatic">
      <basePoint type="pointType">
        <point>
          <id>SKLoc</id>
          <name>SKLoc</name>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </basePoint>
      <duration>0</duration>
      <trajectory>
        <radius type="float">15.0</radius>
      </trajectory>
      <speed type="float" unit="m/s">1.3</speed>
      <annotation>
        <documentation>Station Keeping</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.StationKeeping</implementation-class>
      </annotation>
    </StationKeeping>
  </maneuver>
  <maneuver>
    <Rows kind="automatic">
      <basePoint type="pointType">
        <point>
          <id/>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </basePoint>
      <width>100.0</width>
      <length>50.0</length>
      <height>0.0</height>
      <hstep>27.0</hstep>
      <vstep>0.0</vstep>
      <bearing>0.0</bearing>
      <squareCurve>true</squareCurve>
      <speed unit="m/s">1.0</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.RowsManeuver</implementation-class>
      </annotation>
    </Rows>
  </maneuver>
  <maneuver>
    <RIPattern kind="automatic">
      <basePoint type="pointType">
        <point>
          <id/>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </basePoint>
      <width>60.0</width>
      <hstep>20.0</hstep>
      <bearing>0.0</bearing>
      <squareCurve>true</squareCurve>
      <speed unit="m/s">1.0</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.RIPattern</implementation-class>
      </annotation>
    </RIPattern>
  </maneuver>
  <maneuver>
    <CrossHatchPattern kind="automatic">
      <basePoint type="pointType">
        <point>
          <id/>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </basePoint>
      <width>100.0</width>
      <hstep>20.0</hstep>
      <bearing>0.0</bearing>
      <squareCurve>true</squareCurve>
      <speed unit="m/s">1.0</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.CrossHatchPattern</implementation-class>
      </annotation>
    </CrossHatchPattern>
  </maneuver>
  <maneuver>
    <Elevator kind="automatic">
      <finalPoint type="pointType">
        <point>
          <id>Elevator-Point</id>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </finalPoint>
      <startZ>0.0</startZ>
      <startZUnits>DEPTH</startZUnits>
      <radius>20.0</radius>
      <duration>0</duration>
      <speed unit="m/s">1.0</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.Elevator</implementation-class>
      </annotation>
    </Elevator>
  </maneuver>
  <maneuver>
    <CompassCalibration kind="automatic">
      <finalPoint type="pointType">
        <point>
          <id>CCal</id>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
	    <depth>0.0</depth>
          </coordinate>
        </point>
      </finalPoint>
      <pitch>10.0</pitch>
      <amplitude>0.1</amplitude>
      <duration>1200</duration>
      <speed type="float" unit="m/s">1.0</speed>
      <radius type="float">20.0</radius>
      <direction>Clockwise</direction>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.CompassCalibration</implementation-class>
      </annotation>
    </CompassCalibration>
  </maneuver>
  <maneuver>
    <PopUp kind="automatic">
      <finalPoint type="pointType">
        <point>
          <id>Pop</id>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
	    <depth>0.0</depth>
          </coordinate>
        </point>
      </finalPoint>
      <duration>300</duration>
      <radius>10.0</radius>
      <speed type="float" unit="m/s">1.3</speed>
      <flags CurrPos="true" WaitAtSurface="false"/>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.PopUp</implementation-class>
      </annotation>
    </PopUp>
  </maneuver>
  <maneuver>
    <Launch kind="automatic">
      <finalPoint type="pointType">
        <point>
          <id>Destination</id>
          <name>Destination</name>
          <coordinate>
            <latitude>0N</latitude>
            <longitude>0E</longitude>
            <depth>0.0</depth>
          </coordinate>
        </point>
      </finalPoint>
      <speed type="float" unit="m/s">1.5</speed>
      <annotation>
        <documentation>No documentation available</documentation>
        <implementation-class>pt.lsts.neptus.mp.maneuvers.Launch</implementation-class>
      </annotation>
    </Launch>
  </maneuver>
  </feasibleManeuvers>
  <consoles>
    <console name="LAUV">
      <xml-file>../conf/consoles/lauv.ncon</xml-file>
  </console>
</system>
